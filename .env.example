# Optional newsletter integration (server-only). Never commit real credentials.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
# Optional when the region can be derived from the API key suffix.
MAILCHIMP_SERVER_PREFIX=

# Optional public Google Analytics measurement ID; this is not a secret.
NEXT_PUBLIC_GA_ID=

# Optional absolute path to a staged Long Covid release for local validation.
# Leave unset to use data/birds_eye_reviews/long_covid.
LONG_COVID_DATA_DIR=
